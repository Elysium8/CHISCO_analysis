{
  "chisco_root": "./ds005170/derivatives/preprocessed_pkl",
  "sent_emb_path": "./ds005170/json/sentence_bert_embs.json",
  "task": "imagine",
  "subject_codes": [
    "01",
    "02",
    "03",
    "04",
    "05"
  ],
  "train_data_fraction": 1.0,
  "split_mode": "unseen_sentence",
  "val_split": 0.2,
  "shuffle_data": true,
  "seed": 76,
  "holdout_subjects": [
    "05"
  ],
  "holdout_sent_fraction": 0.2,
  "batch_size": 128,
  "num_epochs": 30,
  "learning_rate": 0.0002,
  "weight_decay": 1e-05,
  "warmup_ratio": 0.1,
  "temperature": 0.05,
  "num_workers": 4,
  "log_every_steps": 50,
  "augment_train": true,
  "noise_std": 0.01,
  "jitter_max": 10,
  "channel_dropout_p": 0.05,
  "hidden_channels": 256,
  "final_hidden": 256,
  "n_blocks": 5,
  "latent_dim": 256,
  "pooling": "mean",
  "use_eegnet": true,
  "eegnet_temporal_kern": 64,
  "eegnet_f1": 16,
  "eegnet_d": 2,
  "raw_frontend_out_ch": 32,
  "use_spatial_attn": true,
  "use_subject_layer": true,
  "use_residual_blocks": true,
  "arch": "brainmodule",
  "baseline_layer": 0,
  "baseline_pooling": "mean",
  "baseline_size1": 8,
  "baseline_size2": 8,
  "baseline_feel1": 125,
  "baseline_feel2": 25,
  "baseline_dropout1": 0.1,
  "baseline_dropout2": 0.1,
  "baseline_latent_dim": 256,
  "exp_root": "experiments",
  "experiment_name": "eeg2text",
  "no_plots": false,
  "device": "cuda"
}